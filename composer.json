{
	"name": "t3bootstrap/t3bootstrap-blog",
	"type": "typo3-cms-extension",
	"description": "t3bootstrap modifications for the blog extension",
	"homepage": "https://t3bootstrap.de",
	"autoload": {
		"psr-4": {
			"T3Bootstrap\\Blog\\": "Classes"
		}
	},
	"authors": [
		{
			"name": "Sven Wappler",
			"role": "Developer",
			"homepage": "https://wappler.systems"
		}
	],
	"license": [
		"GPL-2.0+"
	],
	"require": {
		"typo3/cms-core": "^13",
		"typo3/cms-form": "^13",
		"t3g/blog": "^14.0",
		"t3bootstrap/core": "^13.13.5"
	},
	"require-dev": {
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "t3bootstrap_blog"
		}
	}
}
