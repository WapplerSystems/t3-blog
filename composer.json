{
    "name": "wapplersystems/blog",
    "description": "WapplerSystems fork of t3g/blog with the t3bootstrap bridge folded in: Bootstrap 5 rendering, frontend-user comments, separate storage folders per record type.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Maintainer of fork"
        },
        {
            "name": "TYPO3 GmbH",
            "role": "Upstream developer",
            "homepage": "https://typo3.com/"
        }
    ],
    "homepage": "https://github.com/WapplerSystems/t3-blog",
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-blog/issues",
        "source": "https://github.com/WapplerSystems/t3-blog"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Blog\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WapplerSystems\\Blog\\Tests\\": "Tests/"
        }
    },
    "config": {
        "bin-dir": ".build/bin",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "vendor-dir": ".build/vendor",
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-release/v14": "14.0.x-dev"
        },
        "typo3/cms": {
            "extension-key": "ws_blog"
        },
        "typo3/class-alias-loader": {
            "class-alias-maps": [
                "Migrations/Code/ClassAliasMap.php"
            ]
        }
    },
    "scripts": {
        "test:php:lint": [
            "phplint"
        ],
        "test:php:unit": [
            "phpunit -c Build/UnitTests.xml"
        ],
        "test:php:functional": [
            "phpunit -c Build/FunctionalTests.xml"
        ],
        "phpstan": [
            "phpstan analyze --configuration Build/phpstan.neon"
        ],
        "phpstan:baseline": [
            "phpstan analyze --configuration Build/phpstan.neon --generate-baseline Build/phpstan-baseline.neon"
        ],
        "test": [
            "@test:php:lint",
            "@phpstan",
            "@test:php:unit",
            "@test:php:functional"
        ],
        "cgl": [
            "php-cs-fixer --diff -v fix"
        ]
    },
    "suggest": {
        "bk2k/bootstrap-package": "Theme for TYPO3",
        "typo3/cms-fluid-styled-content": "Content rendering definition based on fluid"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-extensionmanager": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-form": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-install": "^14.3",
        "t3bootstrap/core": "*",
        "wapplersystems/ws-components": "^14",
        "georgringer/numbered-pagination": "^2.0"
    },
    "require-dev": {
        "a9f/typo3-fractor": "^1.0",
        "bk2k/bootstrap-package": "^15.0 || 16.*.*@dev",
        "bk2k/extension-helper": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "overtrue/phplint": "^9.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "typo3/cms-belog": "^14.3",
        "typo3/cms-beuser": "^14.3",
        "typo3/cms-filelist": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-seo": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-tstemplate": "^14.3",
        "typo3/testing-framework": "^9.0.0 || dev-main"
    },
    "replace": {
        "t3g/blog": "self.version",
        "t3bootstrap/t3bootstrap-blog": "self.version"
    }
}
