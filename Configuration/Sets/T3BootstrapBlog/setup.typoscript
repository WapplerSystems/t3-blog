lib.blog.element.sidebar = USER
lib.blog.element.sidebar {
  userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  extensionName = Blog
  pluginName = Sidebar
}

plugin.tx_blog {

  settings {
    sidebarWidgets >
    sidebarWidgets {
      20 = tt_content.blog_categorywidget.20
      30 = tt_content.blog_tagwidget.20
    }


    language = TEXT
    language.data = sitelanguage:twoLetterIsoCode
  }
}

lib.blog.element.commentForm = USER
lib.blog.element.commentForm {
  userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  extensionName = Blog
  pluginName = CommentForm
}
lib.blog.element.comments = USER
lib.blog.element.comments {
  userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  extensionName = Blog
  pluginName = Comments
}
