
plugin {
  tx_blog {
    view {
      templateRootPaths.10 = EXT:t3bootstrap_blog/Resources/Private/Templates/Blog/
      partialRootPaths.10 = EXT:t3bootstrap_blog/Resources/Private/Partials/Blog/
      layoutRootPaths.10 = EXT:t3bootstrap_blog/Resources/Private/Layouts/Blog/

    }

  }
}

page.5.templateRootPaths {
  2 = EXT:t3bootstrap_blog/Resources/Private/Templates/Page/
}

page.5.dataProcessing {
  4000 = files
  4000 {
    references.fieldName = featured_image
    as = featuredImage
  }
}

plugin.tx_t3bootstrapblog {
  view {
    templateRootPaths.0 = EXT:t3bootstrap_blog/Resources/Private/Templates/
    templateRootPaths.10 = {$plugin.tx_t3bootstrapblog.view.templateRootPath}
    partialRootPaths.0 = EXT:t3bootstrap_blog/Resources/Private/Partials/
    partialRootPaths.10 = {$plugin.tx_t3bootstrapblog.view.partialRootPath}
    layoutRootPaths.0 = EXT:t3bootstrap_blog/Resources/Private/Layouts/
    layoutRootPaths.10 = {$plugin.tx_t3bootstrapblog.view.layoutRootPath}
  }
  persistence {
    storagePid = {$plugin.tx_t3bootstrapblog.persistence.storagePid}
  }
  features {
    # uncomment the following line to enable the new Property Mapper.
    # rewrittenPropertyMapper = 1
  }
  settings {

  }
}

blog_ajax = PAGE
blog_ajax {
  typeNum = 74385

  10 = USER
  10 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Blog
    pluginName = Posts
    action = listRecentPosts
    format = ajax.html
    settings =< plugin.tx_blog.settings
    persistence.storagePid = 1961
    persistence.recursive = 250
  }

  config {
    disableAllHeaderCode = 1
    additionalHeaders = Content-type:application/json
    xhtml_cleaning = 0
    admPanel = 0
    debug = 0
    no_cache = 1
  }
}

blog_ajax_category = PAGE
blog_ajax_category {
  typeNum = 74386

  10 = USER
  10 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
